# Copy this file to .env, then replace the placeholders with your own secrets.
# Never commit .env or share its values.

# Copy the full connection string from Neon Console > Connect.
# Keep sslmode=require and URL-encode special characters in the password.
DATABASE_URL=postgresql://ROLE:PASSWORD@HOST/DBNAME?sslmode=require

# Password for the ENKRIPSIH web login (minimum 16 characters).
ENKRIPSIH_PASSWORD=replace-with-a-unique-login-password

# Secret shared between server and KeyBCA firmware (Wemos/ESP32) for challenge-response.
# Must match the value configured in the microcontroller firmware. Minimum 16 characters.
ENKRIPSIH_KEYBCA_SECRET=replace-with-a-strong-random-secret

# Shared secret for HMAC-authenticating IoT device calls (serial bridge / KeyBCA solve).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ENKRIPSIH_IOT_TOKEN=replace-with-an-iot-hmac-token

# Idle session timeout in seconds (default: 300 / 5 minutes).
ENKRIPSIH_SESSION_IDLE_TIMEOUT_SECONDS=300

# Not needed when DATABASE_URL is set. Required only for local SQLCipher mode.
# ENKRIPSIH_DB_PASSPHRASE=replace-with-a-different-database-passphrase

# Set to 1 to enable Swagger/OpenAPI docs at /docs (disable by default for security).
# ENKRIPSIH_ENABLE_DOCS=1
